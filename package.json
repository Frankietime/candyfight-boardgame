{
  "name": "candyfight",
  "private": true,
  "workspaces": [
    "client",
    "server",
    "shared"
  ],
  "compilerOptions": {
    "target": "ESNext",
    "module": "ESNext",
    "moduleResolution": "NodeNext",
    "jsx": "react-jsx",
    "strict": true,
    "baseUrl": "./src",
    "paths": {
      "*": [
        "*",
        "./*"
      ]
    },
    "esModuleInterop": true,
    "forceConsistentCasingInFileNames": true,
    "skipLibCheck": true
  },
  "scripts": {
    "dev": "npm run dev -w client & npm run dev -w server",
    "dev:client": "npm run dev --prefix client",
    "dev:server": "npm run dev --prefix server",
    "install:all": "npm i -w server && npm i -w client",
    "all": "npm-run-all --parallel dev:client dev:server"
  },
  "dependencies": {
    "@ark-ui/react": "^5.27.1",
    "@radix-ui/themes": "^3.2.1",
    "@types/lodash": "^4.17.20",
    "boardgame.io": "^0.50.2",
    "faker": "^6.6.6",
    "g": "^2.0.1",
    "lodash": "^4.17.21",
    "nes.css": "^2.2.1",
    "react95": "^4.0.0",
    "styled-components": "^6.1.19"
  },
  "devDependencies": {
    "@faker-js/faker": "^10.0.0",
    "@types/koa__cors": "^5.0.0",
    "npm-run-all": "^4.1.5",
    "sass-embedded": "^1.93.2"
  }
}