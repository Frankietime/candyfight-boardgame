{
  "name": "candyfight-boardgame",
  "private": true,
  "workspaces": [
    "shared",
    "client",
    "server"
  ],
  "scripts": {
    "dev": "npm run dev -w @candyfight/client & npm run dev -w @candyfight/server",
    "dev:client": "npm run dev -w @candyfight/client",
    "dev:server": "npm run dev -w @candyfight/server",
    "build": "npm run build -w @candyfight/client && npm run build -w @candyfight/server",
    "install:all": "npm install",
    "all": "npm-run-all --parallel dev:client dev:server",
    "test": "npm run test -w @candyfight/shared"
  },
  "devDependencies": {
    "npm-run-all": "^4.1.5"
  }
}
